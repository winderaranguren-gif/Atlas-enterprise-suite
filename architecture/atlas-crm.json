{
  "module": "ATLAS CRM",
  "version": "1.0",
  "scopeRule": "Every CRM record MUST be scoped to legal_entity_id + operating_unit_id (DBA). Users may switch company/DBA without mixing records.",
  "entities": {
    "accounts": ["id","legal_entity_id","operating_unit_id","name","type","industry","website","phone","billing_address","shipping_address","tax_id_ref","status","owner_user_id","created_at","updated_at"],
    "contacts": ["id","legal_entity_id","operating_unit_id","account_id","first_name","last_name","email","phone","title","preferred_language","owner_user_id","created_at","updated_at"],
    "leads": ["id","legal_entity_id","operating_unit_id","source","name","company","email","phone","status","score","owner_user_id","next_action_at","created_at","updated_at"],
    "opportunities": ["id","legal_entity_id","operating_unit_id","account_id","primary_contact_id","name","stage","amount","probability","expected_close_date","owner_user_id","status","created_at","updated_at"],
    "quotes": ["id","legal_entity_id","operating_unit_id","opportunity_id","customer_id","quote_number","status","subtotal","tax","total","valid_until","created_at","updated_at"],
    "tasks": ["id","legal_entity_id","operating_unit_id","related_type","related_id","title","due_at","priority","assigned_user_id","status","created_at","updated_at"],
    "activities": ["id","legal_entity_id","operating_unit_id","related_type","related_id","activity_type","subject","body","actor_user_id","occurred_at"],
    "notes": ["id","legal_entity_id","operating_unit_id","related_type","related_id","body","author_user_id","created_at"],
    "tags": ["id","legal_entity_id","operating_unit_id","name"],
    "attachments": ["id","legal_entity_id","operating_unit_id","related_type","related_id","document_id"]
  },
  "pipeline": ["new","qualified","proposal","negotiation","won","lost"],
  "customerConversion": "A won opportunity may create/update Customer + Accounting customer profile without duplicating the CRM account.",
  "integrations": {
    "Accounting": ["customer master","invoices","payments","AR aging","revenue by customer"],
    "Documents": ["contracts","quotes","artwork","approvals","attachments","version history"],
    "Pages": ["lead forms","customer portal","private stores"],
    "Audit": ["record creation","updates","stage changes","ownership changes","deletions"],
    "CompanySelector": "Changing company/DBA changes CRM scope immediately. Consolidated views are read-only unless explicitly authorized."
  },
  "permissions": ["crm.view","crm.create","crm.edit","crm.delete","crm.assign","crm.export","crm.pipeline.manage","crm.admin"],
  "commercialGate": {
    "status": "blocked_until_backend",
    "requirements": ["real database tables","organization and DBA scoping","authenticated API","RBAC","audit log","backup coverage","restore test"],
    "rule": "Never display CRM as ACTIVE based only on UI availability."
  }
}