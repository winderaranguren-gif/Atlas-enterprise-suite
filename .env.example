# ATLAS Core — example only
# Never commit real credentials or production secrets.

NODE_ENV=development
PORT=4173
ATLAS_ENV=local

# Supabase public browser configuration.
# These values identify the project; RLS remains the actual security boundary.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value in app.js, HTML, mobile code, or public logs.
SUPABASE_SECRET_KEY=

# Optional direct PostgreSQL connection for trusted migrations/server jobs only.
DATABASE_URL=

# Optional legacy key names for older projects or tooling only.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — server/Worker secret only. Never expose this value in browser code.
# Local: copy this file to .env and provide the project key.
# Cloudflare: configure with `npx wrangler secret put OPENAI_API_KEY`.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
