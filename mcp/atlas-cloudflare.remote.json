{
  "schema": "atlas-mcp-remote/v1",
  "name": "ATLAS Cloudflare MCP",
  "transport": "streamable-http",
  "url": "https://mcp.cloudflare.com/mcp",
  "authentication": {
    "preferred": "oauth",
    "fallback": "api-token",
    "storeSecretsInRepository": false
  },
  "capabilities": {
    "read": true,
    "write": true,
    "products": [
      "Workers",
      "Workers Builds",
      "Pages",
      "DNS",
      "R2",
      "D1",
      "KV",
      "Zero Trust",
      "Observability"
    ]
  },
  "atlasPolicy": {
    "productionWrites": "approval-required",
    "previewWrites": "allowed-with-validation",
    "destructiveWrites": "approval-required",
    "directMainMutation": false,
    "secretsInFrontend": false,
    "auditRequired": true
  }
}
