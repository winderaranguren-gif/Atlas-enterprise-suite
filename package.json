{
  "name": "atlas-enterprise-suite",
  "version": "1.14.0-portable-runtime",
  "private": true,
  "type": "module",
  "devDependencies": { "wrangler": "4.118.0" },
  "scripts": {
    "atlas:install": "node atlas/install-node.mjs",
    "atlas:node-agent": "node atlas/node-agent-v2.mjs",
    "atlas:nodes": "node atlas/node-registry.mjs list",
    "atlas:jobs": "node atlas/job-queue.mjs list",
    "atlas:start": "node atlas/supervisor.mjs",
    "atlas:self-heal": "node atlas/self-heal.mjs",
    "atlas:control": "node atlas/control-plane.mjs",
    "atlas:runtime": "node atlas/runtime.mjs",
    "atlas:serve": "node atlas/server.mjs",
    "atlas:status": "node atlas/control-plane.mjs status",
    "atlas:release": "node atlas/control-plane.mjs release",
    "atlas:forge": "node atlas/forge.mjs",
    "atlas:workbench": "node atlas/workbench.mjs",
    "atlas:model": "node atlas/model-engine.mjs",
    "atlas:native-media": "node atlas/native-media-engine.mjs",
    "atlas:connectors": "node atlas/connectors.mjs",
    "atlas:providers": "node atlas/providers.mjs",
    "atlas:oauth": "node atlas/oauth.mjs",
    "atlas:sandbox": "node atlas/sandbox.mjs",
    "atlas:git": "node atlas/git-gateway.mjs",
    "atlas:orchestrate": "node atlas/deploy-orchestrator.mjs",
    "atlas:build": "node atlas/build.mjs",
    "atlas:deploy": "node atlas/deploy.mjs",
    "atlas:backup": "node atlas/backup.mjs",
    "atlas:guardian": "node atlas/guardian.mjs",
    "atlas:vault": "node atlas/vault.mjs",
    "atlas:store": "node atlas/store.mjs",
    "atlas:e2e": "node atlas/e2e.mjs",
    "atlas:verify": "node atlas/build.mjs && node atlas/guardian.mjs && node atlas/control-plane.mjs status",
    "check:finance": "node scripts/validate-finance.mjs",
    "check:launch": "node scripts/validate-launch-queue.mjs",
    "check:global": "node scripts/validate-global.mjs",
    "check:connect": "node scripts/validate-connect.mjs",
    "check:browser": "node scripts/validate-browser.mjs",
    "check:workbench": "node scripts/validate-workbench.mjs",
    "check:portable-runtime": "node scripts/validate-portable-runtime.mjs",
    "check:studio-production": "node scripts/validate-studio-production.mjs",
    "check:native-studio": "node scripts/validate-native-studio.mjs",
    "check:creator-director": "node scripts/validate-creator-director.mjs",
    "check:sovereign-tools": "node scripts/validate-sovereign-tools.mjs",
    "check:git-deploy": "node scripts/validate-git-deploy-tools.mjs",
    "check:capability-state": "node scripts/validate-capability-state-mainline.mjs",
    "check:wallet": "node scripts/validate-wallet.mjs",
    "check:wallet-readiness": "node scripts/wallet-release-readiness.mjs",
    "check:public-site": "node scripts/validate-public-site.mjs",
    "deploy:provider": "wrangler deploy"
  }
}
