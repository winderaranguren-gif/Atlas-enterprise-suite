{
  "name": "atlas-enterprise-suite",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.118.0"
  },
  "scripts": {
    "guard:cloudflare": "node scripts/guard-cloudflare-production.mjs",
    "infra:validate": "node scripts/validate-cloudflare-baseline.mjs",
    "infra:repair": "node scripts/repair-cloudflare-baseline.mjs && npm run infra:validate",
    "atlas:doctor": "node scripts/atlas-doctor.mjs",
    "atlas:verify": "node scripts/atlas-doctor.mjs --full",
    "atlas:self-heal": "npm run infra:repair && npm run atlas:verify",
    "atlas:dna": "node scripts/atlas-dna-scan.mjs",
    "atlas:fruits": "node scripts/atlas-fruit-promotion.mjs",
    "stamp:release": "node scripts/stamp-release.mjs",
    "validate:release": "node scripts/release-sentinel.mjs",
    "validate:guard": "node scripts/test-cloudflare-guard.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:genealogy": "node scripts/validate-genealogy.mjs",
    "validate:fruits": "node scripts/validate-fruit-promotion.mjs",
    "validate:global": "node scripts/validate-global-context.mjs",
    "validate:crm": "node scripts/validate-crm.mjs",
    "validate:backup": "node scripts/test-source-backup.mjs",
    "validate:performance": "node scripts/validate-performance-optimizer.mjs",
    "validate:navigation": "node scripts/validate-functional-navigation.mjs",
    "validate:site100": "node scripts/validate-site100.mjs",
    "validate:web": "node scripts/validate-web-shell.mjs",
    "validate:web-hardening": "node scripts/validate-web-hardening.mjs",
    "validate:commerce-registry": "node scripts/validate-commerce-registry.mjs",
    "validate:commercial-approval": "node scripts/validate-commercial-approval-gate.mjs",
    "validate:merchant-offers": "node scripts/validate-merchant-offer-contract.mjs",
    "validate:cart-revalidation": "node scripts/validate-cart-checkout-revalidation.mjs",
    "validate:commercial-handoff": "node scripts/validate-commercial-transaction-handoff.mjs",
    "validate:meta-catalog": "node scripts/validate-meta-catalog.mjs",
    "validate:capabilities": "node scripts/validate-capability-fusion.mjs",
    "validate:capability-bridges": "node scripts/validate-capability-bridges.mjs",
    "validate:public-capabilities": "node scripts/validate-public-capabilities.mjs",
    "validate:stream-subscriptions": "node scripts/validate-stream-subscription-control.mjs",
    "validate:capability-safe-dom": "node scripts/validate-capability-safe-dom.mjs",
    "validate:forms-control": "node scripts/validate-forms-control.mjs",
    "validate:knowledge-reader": "node scripts/validate-knowledge-reader.mjs",
    "validate:voice": "node scripts/validate-voice-settings.mjs",
    "build:prod": "npm run stamp:release && npm run atlas:dna && npm run guard:cloudflare && npm run infra:validate && npm run validate:release && npm run validate:guard && npm run validate && npm run validate:genealogy && npm run validate:fruits && npm run validate:global && npm run validate:crm && npm run validate:backup && npm run validate:performance && npm run validate:navigation && npm run validate:site100 && npm run validate:web && npm run validate:web-hardening && npm run validate:commerce-registry && npm run validate:commercial-approval && npm run validate:merchant-offers && npm run validate:cart-revalidation && npm run validate:commercial-handoff && npm run validate:meta-catalog && npm run validate:capabilities && npm run validate:capability-bridges && npm run validate:public-capabilities && npm run validate:stream-subscriptions && npm run validate:capability-safe-dom && npm run validate:forms-control && npm run validate:knowledge-reader && npm run validate:voice",
    "deploy": "npm run build:prod && wrangler deploy",
    "deploy:production": "npm run deploy",
    "verify:production": "node scripts/verify-cart-production.mjs && node scripts/verify-order-handoff-production.mjs && node scripts/verify-production-live.mjs",
    "release:production": "npm run deploy:production && npm run verify:production",
    "qa:release": "node scripts/atlas-qa.mjs"
  }
}
