/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), serial=()
  Content-Security-Policy: default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/atlas.config.json
  Cache-Control: no-store, max-age=0

/sw.js
  Cache-Control: no-cache, max-age=0
  Service-Worker-Allowed: /

/*.html
  Cache-Control: no-cache, max-age=0
