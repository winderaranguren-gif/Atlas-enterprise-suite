# ATLAS Module Bridge v1
# Copy to .env locally. NEVER commit the real .env file.

ATLAS_BRIDGE_NODE_ID=winder-laptop-01
ATLAS_BRIDGE_VERSION=1.0.0
ATLAS_BRIDGE_HOST=127.0.0.1
ATLAS_BRIDGE_PORT=8787

# ATLAS cloud heartbeat endpoint, for example:
# https://atlasenterprisesuite.com/api/bridge/heartbeat
ATLAS_BRIDGE_HEARTBEAT_URL=

# Dedicated node secret. Generate a long random value and store it only in
# the laptop's secure secret store / local environment and the server-side secret store.
ATLAS_BRIDGE_NODE_SECRET=

ATLAS_BRIDGE_HEARTBEAT_SECONDS=30
ATLAS_BRIDGE_OFFLINE_AFTER_SECONDS=90
ATLAS_BRIDGE_TUNNEL_KIND=cloudflare

# Comma-separated capabilities exposed by this node.
ATLAS_BRIDGE_CAPABILITIES=voice,files,local-jobs

# Local private voice workspace; keep outside Git.
ATLAS_VOICE_HOME=
