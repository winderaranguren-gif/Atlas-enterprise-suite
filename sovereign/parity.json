{
  "version": 1,
  "authority": "ATLAS Sovereign Core",
  "forge": {
    "replaces": ["GitHub repositories", "branches", "commits", "release metadata", "deploy triggers"],
    "phase1": ["bare git authority", "repository API", "branch/commit inspection"],
    "phase2": ["pull-request review model", "artifact registry", "signed releases", "runner fleet"],
    "phase3": ["web IDE", "issues/projects", "package registry", "full mirror federation"]
  },
  "edge": {
    "replaces": ["Cloudflare Workers deployment authority", "canonical routing", "release promotion", "rollback", "origin health"],
    "phase1": ["TLS gateway config", "atomic releases", "readiness", "rollback"],
    "phase2": ["cache policy", "rate limits", "WAF rules", "origin pools", "deployment history"],
    "phase3": ["multi-region edge nodes", "authoritative DNS option", "distributed cache", "global traffic steering"]
  },
  "externalPolicy": {
    "github": "mirror-only",
    "cloudflare": "optional-edge-or-dns-only",
    "supabase": "migration-source-until-postgres-cutover",
    "vercel": "non-authoritative"
  }
}
