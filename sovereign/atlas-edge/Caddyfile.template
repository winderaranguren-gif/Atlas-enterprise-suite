atlasenterprisesuite.com, www.atlasenterprisesuite.com {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  handle /_atlas/edge/* {
    uri strip_prefix /_atlas/edge
    reverse_proxy 127.0.0.1:7402
  }
  handle /_atlas/runtime/* {
    respond 404
  }
  handle {
    reverse_proxy 127.0.0.1:7403 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
  log {
    output file /opt/atlas/logs/access.log
  }
}
