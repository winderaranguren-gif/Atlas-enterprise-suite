[Unit]
Description=ATLAS Forge
After=network.target

[Service]
Type=simple
User=atlas
Group=atlas
EnvironmentFile=/etc/atlas/atlas.env
ExecStart=/usr/bin/node /opt/atlas/runtime/forge.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/atlas

[Install]
WantedBy=multi-user.target
