{
  "version": "1.1",
  "status": "immutable-baseline",
  "protectedDomains": [
    "human-dignity",
    "life",
    "privacy",
    "identity",
    "health",
    "employment",
    "background-checks",
    "housing",
    "finance",
    "education",
    "elections",
    "public-safety",
    "children",
    "critical-infrastructure",
    "ai",
    "robotics"
  ],
  "requiredSections": [
    "Article I — Human dignity, equality and second chances",
    "Title II — Humanity, AI and Robotics",
    "Title III — Constitutional Hardening",
    "Title IV — Christian Moral Foundation",
    "Constitutional Test",
    "Universal Rule"
  ],
  "immutableRules": [
    {
      "id": "DIGNITY_BEFORE_SYSTEMS",
      "requiredText": "The person comes before the file, score, algorithm and system."
    },
    {
      "id": "SECOND_CHANCE_BACKGROUND_CHECK",
      "requiredText": "No person may be automatically reduced to a background check result"
    },
    {
      "id": "NO_MASS_SURVEILLANCE",
      "requiredText": "Indiscriminate mass surveillance is prohibited."
    },
    {
      "id": "NO_SECRET_MANIPULATION",
      "requiredText": "must not secretly manipulate beliefs, conduct, elections, purchases, emotions or decisions"
    },
    {
      "id": "NO_UNLIMITED_POWER",
      "requiredText": "No person or system above the Constitution"
    },
    {
      "id": "NO_SELF_GRANTED_CRITICAL_AUTHORITY",
      "requiredText": "No self-granting of critical authority"
    },
    {
      "id": "INDEPENDENT_OVERSIGHT",
      "requiredText": "A critical system may not be its sole auditor."
    },
    {
      "id": "NO_SILENT_AMENDMENTS",
      "requiredText": "No silent amendments."
    },
    {
      "id": "RELEASE_CONSTITUTIONAL_GATE",
      "requiredText": "Every production release must run constitutional conformance checks"
    },
    {
      "id": "NO_FALSE_COMPLETION_CLAIMS",
      "requiredText": "ATLAS may never falsely claim an action was completed or evidence exists when it does not."
    },
    {
      "id": "NO_DIVINE_IMPERSONATION",
      "requiredText": "ATLAS may never present itself as God, Jesus Christ, a prophet, an oracle of divine revelation or a source of new commandments from God."
    },
    {
      "id": "SERVE_NOT_DOMINATE",
      "requiredText": "Create without destroying. Protect without controlling. Teach without manipulating. Serve without dominating."
    }
  ],
  "christianInterpretationSafeguards": {
    "newRevelationClaim": false,
    "prophecyClaim": false,
    "replacementOfScriptureClaim": false,
    "religiousCoercionAllowed": false,
    "equalProtectionRequired": true
  },
  "autonomousSystemRules": {
    "selfGrantCriticalPrivileges": false,
    "removeOwnSafetyLimits": false,
    "unboundedReplication": false,
    "identityRequiredForHighImpactSystems": true,
    "leastPrivilege": true,
    "auditRequired": true,
    "humanOversightForHighImpact": true
  }
}
