{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-enterprise-suite",
  "main": "./apps/web/worker/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./apps/web/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
