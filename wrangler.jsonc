{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-enterprise-suite",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_AT_DEPLOY_TIME",
      "database_id": "REPLACE_AT_DEPLOY_TIME",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "REPLACE_AT_DEPLOY_TIME"
    }
  ],
  "vars": {
    "ATLAS_DEFAULT_LANGUAGE": "en",
    "ATLAS_SUPPORTED_LANGUAGES": "en,es",
    "ATLAS_DEPLOYED_SHA": "LOCAL_NOT_PRODUCTION"
  }
}
