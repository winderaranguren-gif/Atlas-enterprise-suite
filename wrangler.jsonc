{
  "name": "atlas-enterprise-suite",
  "main": "rideos-router.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {"name": "VIDEO_ROOMS", "class_name": "VideoRoom"},
      {"name": "CONNECT_STORE", "class_name": "ConnectStore"},
      {"name": "WALLET_STORE", "class_name": "WalletStore"}
    ]
  },
  "migrations": [
    {"tag": "v1-video-room", "new_sqlite_classes": ["VideoRoom"]},
    {"tag": "v2-connect-store", "new_sqlite_classes": ["ConnectStore"]},
    {"tag": "v3-wallet-store", "new_sqlite_classes": ["WalletStore"]}
  ],
  "routes": [
    {"pattern": "atlasenterprisesuite.com/*", "zone_id": "26a5b368f6a017801a4600b19748c3ab"},
    {"pattern": "www.atlasenterprisesuite.com/*", "zone_id": "26a5b368f6a017801a4600b19748c3ab"}
  ],
  "observability": {"enabled": true}
}