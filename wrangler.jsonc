{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-enterprise-suite",
  "main": "cloudflare/worker-entry.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "build": {
    "command": "node scripts/cloudflare-build-router.js"
  },
  "routes": [
    {
      "pattern": "atlasenterprisesuite.com",
      "custom_domain": true
    },
    {
      "pattern": "www.atlasenterprisesuite.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
