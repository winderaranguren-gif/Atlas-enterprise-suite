# ATLAS GPS gateway
ATLAS_GPS_PORT=4280
ATLAS_GPS_HOST=0.0.0.0
ATLAS_GPS_PUBLIC_ORIGIN=http://127.0.0.1:4173
ATLAS_GPS_ALLOWED_ORIGINS=http://127.0.0.1:4173,https://atlas.example.com
ATLAS_GPS_ADMIN_TOKEN=replace-with-a-long-random-secret
ATLAS_GPS_ALLOW_PUBLIC_DEMO=false
ATLAS_GPS_LOG_RETENTION_DAYS=7
ATLAS_GPS_LOCATION_RETENTION_SECONDS=0

# ATLAS-controlled services
ATLAS_TILE_STYLE_URL=https://maps.atlas.example.com/styles/atlas/style.json
ATLAS_TILE_SERVER_URL=http://martin:3000
ATLAS_SEARCH_URL=http://pelias-api:4000/v1
ATLAS_ROUTER_URL=http://valhalla:8002
ATLAS_ELEVATION_URL=http://elevation:8080
ATLAS_OFFLINE_BASE_URL=https://offline.atlas.example.com
ATLAS_OBJECT_STORAGE_ENDPOINT=http://minio:9000
ATLAS_OBJECT_STORAGE_BUCKET=atlas-gps-offline
ATLAS_OBJECT_STORAGE_ACCESS_KEY=atlas
ATLAS_OBJECT_STORAGE_SECRET_KEY=replace-me

# Licensed or public-authority provider adapters
ATLAS_TRAFFIC_URL=
ATLAS_TRAFFIC_TOKEN=
ATLAS_INCIDENTS_URL=
ATLAS_INCIDENTS_TOKEN=
ATLAS_CLOSURES_URL=
ATLAS_CLOSURES_TOKEN=
ATLAS_CONSTRUCTION_URL=
ATLAS_CONSTRUCTION_TOKEN=
ATLAS_FLOODS_URL=
ATLAS_FLOODS_TOKEN=
ATLAS_WEATHER_URL=
ATLAS_WEATHER_TOKEN=
ATLAS_ROAD_STATUS_URL=
ATLAS_ROAD_STATUS_TOKEN=
ATLAS_TRANSIT_URL=
ATLAS_TRANSIT_TOKEN=
ATLAS_MARITIME_URL=
ATLAS_MARITIME_TOKEN=
ATLAS_AVIATION_URL=
ATLAS_AVIATION_TOKEN=

# Data images and import jobs. Pin these in the production environment.
ATLAS_POSTGIS_IMAGE=postgis/postgis:16-3.4
ATLAS_REDIS_IMAGE=redis:7-alpine
ATLAS_MINIO_IMAGE=minio/minio:latest
ATLAS_MARTIN_IMAGE=ghcr.io/maplibre/martin:latest
ATLAS_VALHALLA_IMAGE=ghcr.io/gis-ops/docker-valhalla/valhalla:latest
ATLAS_NOMINATIM_IMAGE=mediagis/nominatim:4.5
