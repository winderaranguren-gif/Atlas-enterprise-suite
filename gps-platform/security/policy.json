{
  "version": 1,
  "classification": {
    "preciseLocation": "restricted",
    "routeHistory": "restricted",
    "cameraFrames": "restricted",
    "voiceCommands": "confidential",
    "searchHistory": "confidential",
    "anonymousMapTelemetry": "internal"
  },
  "defaults": {
    "locationHistory": false,
    "rawCameraUpload": false,
    "voiceRecordingRetention": false,
    "personalizedAdvertising": false,
    "crossTenantSharing": false,
    "crashTelemetry": "opt-in",
    "analytics": "opt-in"
  },
  "encryption": {
    "transport": "TLS 1.3 preferred; TLS 1.2 minimum",
    "locationAtRest": "AES-256-GCM",
    "offlinePackages": "signed Ed25519; optional device encryption",
    "providerSecrets": "environment or managed secret vault only",
    "mobileKeyStorage": "iOS Keychain / Android Keystore"
  },
  "retention": {
    "preciseLocationSeconds": 0,
    "serverRequestLogsDays": 7,
    "securityAuditDays": 365,
    "offlinePackageMetadataDays": 90,
    "userControlledHistory": true
  },
  "permissions": {
    "location": "while-in-use by default; always only for explicit background navigation",
    "camera": "while-in-use and navigation screen visible",
    "microphone": "only during explicit voice command",
    "notifications": "optional for background guidance",
    "motion": "optional for dead reckoning"
  },
  "enterpriseControls": [
    "tenant isolation",
    "role-based access",
    "provider-key separation",
    "regional data residency",
    "retention override within legal limits",
    "device revocation",
    "audit export",
    "remote offline-package revocation"
  ],
  "requiredReleaseGates": [
    "threat model approved",
    "dependency scan passes",
    "secret scan passes",
    "mobile permission review passes",
    "tenant isolation test passes",
    "location purge test passes",
    "offline signature verification passes",
    "incident response exercise completed"
  ]
}
